# Mira Verify API - Environment Variables
#
# For local development, copy this to .dev.vars
# For production, set these as Cloudflare Workers secrets:
#   wrangler secret put SECRET_NAME

# ===================
# Required Secrets
# ===================

# Stripe API secret key (starts with sk_)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# Mira API key for AI verification
MIRA_API_KEY=

# Better Auth secret for session signing (generate random string)
BETTER_AUTH_SECRET=

# Google OAuth credentials (required for authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===================
# Optional Secrets
# ===================

# Groo plugin token for version lookup (leave empty to disable /download/plugin)
GROO_PLUGIN_TOKEN=

# ===================
# Wrangler Config
# ===================
# These are set in wrangler.jsonc, not as secrets:
#
# APP_URL=https://factpress.ai  (vars section)
# APP_VERSION=dev                          (set by CI/CD)
# DB=                                      (D1 database binding)
